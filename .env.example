# Supabase 대시보드 > Project Settings > API (또는 Connect 버튼)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon public" 키 (새 키 체계에서는 "publishable" 키). 브라우저에 노출돼도 됨 — RLS 가 보호
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" 키 (새 키 체계에서는 "secret" 키). 서버 전용 — 절대 공개 금지
SUPABASE_SERVICE_ROLE_KEY=
# 관리자로 허용할 이메일 (이 주소로만 /admin 로그인 가능)
OWNER_EMAIL=you@example.com
# 선택(권장): 첫 로그인 후 Supabase > Authentication > Users 의 본인 User UID
# OWNER_USER_ID=
# sitemap·OG 태그용 절대 주소 (배포 후 실제 주소로)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 선택: 첨부파일 1개당 최대 크기(MB), 기본 25. Supabase 무료 플랜 상한은 50MB
# NEXT_PUBLIC_MAX_UPLOAD_MB=25
# 선택: Vercel 대시보드에서 Web Analytics 를 켠 뒤 1 로 설정
# NEXT_PUBLIC_ENABLE_ANALYTICS=1
